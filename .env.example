# Optional overrides for docker compose: cp .env.example .env
# Everything works without this file - defaults are fine for running on your own computer.

# Names of the locally built images: <DOCKERHUB_NAMESPACE>/wordmaster-backend:<WORDMASTER_VERSION>
# Set your Docker Hub login to publish them with "docker compose push"
DOCKERHUB_NAMESPACE=wordmaster
WORDMASTER_VERSION=latest

# Public port of the application
APP_PORT=80

# JWT signing secret, at least 32 characters. Generate: openssl rand -base64 48
JWT_SECRET=change-me-to-a-long-random-secret-at-least-32-chars

# Admin account created on first start
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@wordmaster.local
ADMIN_PASSWORD=admin12345

# Database
DB_NAME=WORDMASTER
DB_USER_NAME=word_master_user
DB_USER_PASSWORD=password

APP_TIME_ZONE=Europe/Moscow
CORS_ALLOWED_ORIGINS=http://localhost
