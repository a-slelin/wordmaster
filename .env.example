# Copy to .env and adjust: cp .env.example .env

# Database
DB_HOST=localhost
DB_PORT=5432
DB_NAME=WORDMASTER
DB_USER_NAME=word_master_user
DB_USER_PASSWORD=change-me

# JWT signing secret (HS256). At least 32 characters! Generate: openssl rand -base64 48
JWT_SECRET=change-me-to-a-long-random-secret-at-least-32-chars

# Optional: bootstrap admin account on first start (leave empty to skip)
ADMIN_USERNAME=
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Public port of the web application
APP_PORT=80
